# Copy to .env and fill in every value. Never commit .env.

# Public hostname only. No scheme, no trailing slash. Also enables FORCE_SSL.
HOST=

# Microsoft Entra tenant and App registration values.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# PostgreSQL credentials used by both the database and the application.
POSTGRES_USER=docuseal
POSTGRES_PASSWORD=
POSTGRES_DB=docuseal

# SECRET_KEY_BASE and ENCRYPTION_SECRET are generated on first boot into
# ./docuseal/docuseal.env. Set them here only to supply your own values.
# SECRET_KEY_BASE=
# ENCRYPTION_SECRET=
