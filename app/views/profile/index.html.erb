<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">
      <%= t('profile') %>
    </h1>
    <%= fields_for current_user do |f| %>
      <div class="space-y-4">
        <div class="grid md:grid-cols-2 gap-4">
          <div class="form-control">
            <%= f.label :first_name, t('first_name'), class: 'label' %>
            <%= f.text_field :first_name, class: 'base-input', dir: 'auto', disabled: true %>
          </div>
          <div class="form-control">
            <%= f.label :last_name, t('last_name'), class: 'label' %>
            <%= f.text_field :last_name, class: 'base-input', dir: 'auto', disabled: true %>
          </div>
        </div>
        <div class="form-control">
          <%= f.label :email, t('email'), class: 'label' %>
          <%= f.email_field :email, autocomplete: 'off', class: 'base-input', disabled: true %>
        </div>
        <span class="label-text-alt">Managed by Microsoft Entra ID</span>
      </div>
    <% end %>
    <div class="mt-8 rounded-2xl bg-base-200 p-5">
      <p class="text-xl font-bold">Microsoft 365</p>
      <% if current_user.microsoft_reauthorization_required? %>
        <p class="mt-2 text-error">Your Microsoft connection needs to be renewed before email can be sent.</p>
        <%= link_to 'Reconnect Microsoft 365', microsoft_auth_path(return_to: settings_profile_index_path), class: 'base-button w-full mt-4', data: { turbo: false } %>
      <% elsif current_user.microsoft_connected? %>
        <p class="mt-2">Connected as <%= current_user.email %>. Email is sent through your Microsoft 365 mailbox.</p>
      <% else %>
        <p class="mt-2 text-warning">Microsoft mail permission has not been connected.</p>
        <%= link_to 'Connect Microsoft 365', microsoft_auth_path(return_to: settings_profile_index_path), class: 'base-button w-full mt-4', data: { turbo: false } %>
      <% end %>
    </div>
    <%= render 'email_configs' %>
    <p class="text-2xl font-bold mt-8 mb-4">
      <%= t('signature') %>
    </p>
    <% signature = UserConfigs.load_signature(current_user) %>
    <% if signature %>
      <div class="flex justify-center mb-4 relative">
        <%= button_to button_title(title: t('remove'), disabled_with: t('removing')), user_signature_path, method: :delete, class: 'right-0 top-0 absolute link' %>
        <img src="<%= signature.url(time: ActiveStorage::Attachment.service_url_time) %>" style="height: 130px; width: 100%; object-fit: contain;">
      </div>
    <% end %>
    <a href="<%= edit_user_signature_path %>" data-turbo-frame="modal" class="base-button w-full">
      <%= t('update_signature') %>
    </a>
    <p class="text-2xl font-bold mt-8 mb-4">
      <%= t('initials') %>
    </p>
    <% initials = UserConfigs.load_initials(current_user) %>
    <% if initials %>
      <div class="flex justify-center mb-4 relative">
        <%= button_to button_title(title: t('remove'), disabled_with: t('removing')), user_initials_path, method: :delete, class: 'right-0 top-0 absolute link' %>
        <img src="<%= initials.url(time: ActiveStorage::Attachment.service_url_time) %>" style="height: 130px; width: 100%; object-fit: contain;">
      </div>
    <% end %>
    <a href="<%= edit_user_initials_path %>" data-turbo-frame="modal" class="base-button w-full">
      <%= t('update_initials') %>
    </a>
  </div>
  <div class="w-0 md:w-52"></div>
</div>
