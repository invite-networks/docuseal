<%= content_for(:canonical_url, new_user_session_url) %>
<div class="max-w-lg mx-auto px-2">
  <h1 class="text-4xl font-bold text-center mt-8"><%= t('sign_in') %></h1>
  <p class="text-center text-base-content/70 mt-3 mb-6">
    Use your INVITE Networks Microsoft 365 account to continue.
  </p>
  <%= link_to microsoft_auth_path(redir: params[:redir]), class: 'base-button w-full', data: { turbo: false } do %>
    <%= t('sign_in_with_microsoft') %>
  <% end %>
</div>
