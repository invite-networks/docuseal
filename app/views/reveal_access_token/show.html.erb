<%= render 'shared/turbo_modal', title: t('reveal_api_key') do %>
  <% if @token %>
    <div class="flex space-x-4">
      <%= render 'reveal_access_token/access_token', token: @token %>
    </div>
  <% else %>
    <p class="mb-4">Verify your identity with Microsoft before revealing the API key.</p>
    <%= link_to 'Continue with Microsoft',
                microsoft_auth_path(prompt: 'login', return_to: settings_api_index_path),
                class: 'base-button', data: { turbo: false } %>
  <% end %>
<% end %>
